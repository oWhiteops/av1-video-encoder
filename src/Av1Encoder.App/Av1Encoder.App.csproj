<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AV1VideoEncoder</AssemblyName>
    <Product>AV1 Video Encoder</Product>
    <Version>1.8.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WPF's Fluent theme (ThemeMode) is flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Av1Encoder.Engine\Av1Encoder.Engine.csproj" />
  </ItemGroup>

  <!-- Bundle FFmpeg (fetched by scripts\fetch-ffmpeg.ps1) and third-party notices next to the executable. -->
  <PropertyGroup>
    <FfmpegDir>$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\</FfmpegDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(FfmpegDir)bin\*.exe;$(FfmpegDir)bin\*.dll" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(FfmpegDir)LICENSE.txt" Link="licenses\FFmpeg-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(FfmpegDir)VERSION.txt" Link="licenses\FFmpeg-VERSION.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="CheckFfmpeg" BeforeTargets="Build">
    <Error Condition="!Exists('$(FfmpegDir)bin\ffmpeg.exe')" Text="FFmpeg is missing. Run scripts\fetch-ffmpeg.ps1 first." />
  </Target>

</Project>
