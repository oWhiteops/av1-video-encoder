<Window x:Class="Av1Encoder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AV1 Video Encoder" Width="800" Height="920" MinWidth="640" MinHeight="620"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        Closing="OnClosing" Loaded="OnLoaded">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding TaskbarProgress, Mode=OneWay}" ProgressState="{Binding TaskbarState, Mode=OneWay}" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PresetCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" Padding="14,12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="AV1 Video Encoder" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                   Text="Make videos smaller with modern AV1 compression. Everything stays on your PC." />
                    </StackPanel>
                    <Button Content="View log" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnShowLog" />
                </Grid>

                <!-- Mode -->
                <UniformGrid Columns="2" Margin="0,0,-8,16" IsEnabled="{Binding CanEdit}">
                    <RadioButton Style="{StaticResource PresetCard}" GroupName="Mode" IsChecked="{Binding IsCompressMode}" AutomationProperties.Name="Compress mode">
                        <StackPanel>
                            <TextBlock Text="Compress" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource StatLabel}" Margin="0,4,0,0" Text="Make a video smaller at a chosen quality." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PresetCard}" GroupName="Mode" IsChecked="{Binding IsDiscordMode}" AutomationProperties.Name="Video to Discord mode">
                        <StackPanel>
                            <TextBlock Text="Video to Discord" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource StatLabel}" Margin="0,4,0,0" Text="Fit a video under an upload size limit." />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <!-- Error -->
                <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEA39;" FontSize="16"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,1,12,0" VerticalAlignment="Top" />
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Encode anyway at lower quality"
                                Click="OnEncodeAnyway" Visibility="{Binding CanEncodeAnyway, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- Source -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Video" Style="{StaticResource CardTitle}" />
                        <Border x:Name="DropZone" CornerRadius="8" BorderThickness="2" Padding="24,28" Cursor="Hand"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                MouseLeftButtonUp="OnBrowseInput">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B2;" FontSize="36"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Drag videos here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                <TextBlock Style="{StaticResource Secondary}" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="or click to browse · MP4, MOV, MKV, AVI, WebM and more · several videos or a folder to compress a batch" />
                            </StackPanel>
                        </Border>
                        <Button Content="Choose a folder…" Click="OnBrowseFolder" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                ToolTip="Add every video in a folder and its subfolders">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasMedia}" Value="False" />
                                                <Condition Binding="{Binding IsCompressMode}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Batch -->
                        <StackPanel Visibility="{Binding IsBatch, Converter={StaticResource Vis}}">
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Clear all" Click="OnClearQueue" IsEnabled="{Binding CanEdit}" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Add folder…" Click="OnBrowseFolder" IsEnabled="{Binding CanEdit}" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Add videos…" Click="OnBrowseInput" IsEnabled="{Binding CanEdit}" />
                                <TextBlock Text="{Binding BatchSummary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Queue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Click="OnRemoveFromQueue" VerticalAlignment="Center" Padding="8,4"
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE711;" ToolTip="Remove from the list"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}"
                                                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource StatLabel}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatLabel}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource StatLabel}" Margin="0,8,0,0"
                                       Text="Videos are encoded one after another with the quality, encoder and audio settings below. Batches get no size or time estimate." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowSingle, Converter={StaticResource Vis}}">
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Remove" Click="OnRemoveVideo" IsEnabled="{Binding CanEdit}" Margin="8,0,0,0"
                                        ToolTip="Remove this video so you can add a different one" />
                                <Button DockPanel.Dock="Right" Content="Add folder…" Click="OnBrowseFolder" IsEnabled="{Binding CanEdit}" Margin="8,0,0,0"
                                        Visibility="{Binding IsCompressMode, Converter={StaticResource Vis}}" ToolTip="Add every video in a folder to compress as a batch" />
                                <Button DockPanel.Dock="Right" Content="Add more…" Click="OnBrowseInput" IsEnabled="{Binding CanEdit}"
                                        Visibility="{Binding IsCompressMode, Converter={StaticResource Vis}}" ToolTip="Add more videos to compress as a batch" />
                                <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding SourceInfo}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,16,10">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Estimate + quality check (both modes) -->
                            <TextBlock Text="{Binding EstimateLine}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Quality check -->
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsAnalyzing, Converter={StaticResource Vis}}">
                                    <Button Content="Cancel" Click="OnCancelAnalysis" Margin="8,0,0,0" />
                                    <Button Content="Skip" Click="OnSkipAnalysis" Margin="8,0,0,0" ToolTip="Stop and don't check future videos" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource Secondary}" />
                                    <ProgressBar Value="{Binding AnalysisPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                 Visibility="{Binding IsAnalyzing, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DockPanel>
                            <CheckBox Content="Skip the quality check (no size or time estimate; rougher Discord advice)" IsChecked="{Binding SkipQualityAnalysis}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Style="{StaticResource Card}" Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />
                        </DockPanel>
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" />
                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <StackPanel><TextBlock Text="Elapsed" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding ElapsedText}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Remaining" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding RemainingText}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Speed" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding SpeedText}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Output size" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding EstimateText}" Style="{StaticResource StatValue}" /></StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource StatLabel}" Margin="0,10,0,0"
                                   Text="Progress, time remaining and size are estimates and settle as encoding proceeds." />
                    </StackPanel>
                </Border>

                <!-- Result -->
                <Border Style="{StaticResource Card}" Visibility="{Binding ShowResult, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE930;" FontSize="20"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Open folder" Click="OnOpenFolder" Style="{DynamicResource AccentButtonStyle}" />
                            <Button DockPanel.Dock="Right" Content="Copy file" Click="OnCopyFile" Margin="0,0,8,0"
                                    ToolTip="Copy the encoded file to the clipboard, to paste into Discord, an email or a folder" />
                            <TextBlock Text="Encoding complete" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Final size" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding ResultSize}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding ResultSavedLabel}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding ResultSaved}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="{Binding ResultTimeLabel}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding ResultTime}" Style="{StaticResource StatValue}" /></StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,12,0,0" Text="{Binding ResultNotes}"
                                   Visibility="{Binding HasResultNotes, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>
                <!-- Discord -->
                <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}" Visibility="{Binding IsDiscordMode, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Discord upload" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,12" Visibility="{Binding ShowDiscordBatchNote, Converter={StaticResource Vis}}"
                                   Text="Video to Discord works on one video at a time. Remove videos from the list until one is left, or switch to Compress to encode them all." />

                        <TextBlock Text="Size limit" Style="{StaticResource StatLabel}" Margin="0,0,0,6" />
                        <WrapPanel>
                            <RadioButton GroupName="Target" Content="Discord Free (19 MB)" IsChecked="{Binding UseFreeTarget}" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <RadioButton GroupName="Target" Content="Custom" IsChecked="{Binding UseCustomTarget}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="90" Text="{Binding CustomTargetText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomTarget}"
                                     AutomationProperties.Name="Custom size limit in MB" VerticalAlignment="Center" />
                            <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,16,0" />
                            <TextBlock Text="{Binding TargetBytesText}" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="{Binding SizeLine}" Style="{StaticResource Secondary}" Margin="0,8,0,0" />

                        <TextBlock Text="Priority" Style="{StaticResource StatLabel}" Margin="0,16,0,6" />
                        <UniformGrid Columns="3" Margin="0,0,-8,0">
                            <RadioButton Style="{StaticResource PresetCard}" GroupName="Strategy" IsChecked="{Binding IsBestStrategy}">
                                <StackPanel>
                                    <TextBlock Text="Best Quality" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,4,0,0" Text="Sharpest result. Slowest; suggests trimming first." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PresetCard}" GroupName="Strategy" IsChecked="{Binding IsBalancedStrategy}">
                                <StackPanel>
                                    <TextBlock Text="Balanced (recommended)" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,4,0,0" Text="Good quality at a reasonable speed." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PresetCard}" GroupName="Strategy" IsChecked="{Binding IsFastestStrategy}">
                                <StackPanel>
                                    <TextBlock Text="Fastest" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,4,0,0" Text="Quickest encode; a little softer." />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <!-- Recommendation -->
                        <Border CornerRadius="8" Padding="16,12" Margin="0,16,0,0" BorderThickness="1"
                                Visibility="{Binding HasPlan, Converter={StaticResource Vis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlanIsRisky}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding PlanHeadline}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding PlanAdvice}" Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                           Visibility="{Binding HasPlanAdvice, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding PlanWarnings}" Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                           Visibility="{Binding HasPlanWarnings, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding PlanError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding HasPlanError, Converter={StaticResource Vis}}" />

                        <!-- Trim -->
                        <TextBlock Text="Trim" Style="{StaticResource StatLabel}" Margin="0,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Width="100" Text="{Binding TrimStartText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Trim start" />
                            <TextBlock Grid.Column="3" Text="End" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="4" Width="100" Text="{Binding TrimEndText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Trim end" />
                            <TextBlock Grid.Column="5" Text="{Binding SelectedDurationText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <Image Grid.Row="1" Grid.ColumnSpan="2" Source="{Binding StartFrame}" Height="90" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="First frame of the selection" />
                            <Image Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Source="{Binding EndFrame}" Height="90" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Last frame of the selection" />
                        </Grid>
                        <TextBlock Text="{Binding TrimError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasTrimError, Converter={StaticResource Vis}}" />
                        <TextBlock Style="{StaticResource StatLabel}" Margin="0,6,0,0" Text="Times as m:ss, for example 1:05.5. Nothing is cut unless you change these." />

                        <!-- Overrides -->
                        <Expander Header="Adjust resolution, frame rate and audio" Margin="0,14,0,0">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="Resolution" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding SelectedResolution}" DisplayMemberPath="Label"
                                          HorizontalAlignment="Left" MinWidth="240" Margin="0,0,0,8" AutomationProperties.Name="Resolution" />
                                <TextBlock Grid.Row="1" Text="Frame rate" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FrameRateChoices}" SelectedItem="{Binding SelectedFrameRate}" DisplayMemberPath="Label"
                                          HorizontalAlignment="Left" MinWidth="240" Margin="0,0,0,8" AutomationProperties.Name="Frame rate" />
                                <TextBlock Grid.Row="2" Text="Audio" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AudioChoices}" SelectedItem="{Binding SelectedAudio}" DisplayMemberPath="Label"
                                          HorizontalAlignment="Left" MinWidth="240" Margin="0,0,0,8" AutomationProperties.Name="Audio" />
                                <Button Grid.Row="3" Grid.Column="1" Content="Reset to recommended" Click="OnResetOverrides" HorizontalAlignment="Left" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Quality -->
                <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}" Visibility="{Binding IsCompressMode, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Quality" Style="{StaticResource CardTitle}" />
                        <UniformGrid Columns="3" Margin="0,0,-8,0">
                            <RadioButton Style="{StaticResource PresetCard}" GroupName="Preset" IsChecked="{Binding IsHighQuality}">
                                <StackPanel>
                                    <TextBlock Text="High Quality" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,4,0,0" Text="Near-transparent quality. Slower to encode." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PresetCard}" GroupName="Preset" IsChecked="{Binding IsBalanced}">
                                <StackPanel>
                                    <TextBlock Text="Balanced (recommended)" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,4,0,0" Text="Looks great, much smaller, reasonable speed." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource PresetCard}" GroupName="Preset" IsChecked="{Binding IsSmallest}">
                                <StackPanel>
                                    <TextBlock Text="Smallest File" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource StatLabel}" Margin="0,4,0,0" Text="Maximum savings, still clear. Some detail loss." />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <Expander Header="Advanced options" Margin="0,14,0,0">
                            <StackPanel Margin="0,10,0,0">
                                <CheckBox Content="Use custom quality instead of a preset" IsChecked="{Binding UseCustom}" />
                                <Grid Margin="28,8,0,0" IsEnabled="{Binding UseCustom}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Quality (CRF)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="10" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding CustomCrf}" VerticalAlignment="Center" AutomationProperties.Name="Quality CRF" />
                                    <TextBlock Grid.Column="2" Text="{Binding CustomCrf}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatLabel}" Margin="0,0,0,8"
                                               Text="{Binding CrfHint, Mode=OneWay}" />
                                    <TextBlock Grid.Row="2" Text="Encoder speed" VerticalAlignment="Center" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="2" Maximum="12" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding CustomSpeed}" VerticalAlignment="Center" AutomationProperties.Name="Encoder speed" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CustomSpeed}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource StatLabel}"
                                               Text="SVT-AV1 preset. Lower = slower but slightly smaller files." />
                                </Grid>

                                <TextBlock Text="Encoder" Margin="0,16,0,6" />
                                <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding SelectedEncoder}" DisplayMemberPath="Label"
                                          HorizontalAlignment="Left" MinWidth="380" AutomationProperties.Name="Encoder" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding HardwareStatus}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource StatLabel}" Margin="0,2,0,0"
                                           Text="All encoders output AV1. If a hardware encoder fails, encoding automatically continues in software." />

                                <CheckBox Content="Keep audio" IsChecked="{Binding KeepAudio}" Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource StatLabel}" Margin="28,2,0,0"
                                           Text="AAC audio is copied unchanged; other formats are converted to high-quality AAC." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Output -->
                <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TextBlock Text="Save to" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Folder" Style="{StaticResource StatLabel}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Same as video" Margin="8,0,0,0" Click="OnUseSourceFolder" />
                            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseOutput" />
                            <TextBox Text="{Binding OutputFolder}" AutomationProperties.Name="Output folder" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding IsSingle, Converter={StaticResource Vis}}">
                            <TextBlock Text="File name" Style="{StaticResource StatLabel}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output file name" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Margin="0,8,0,0" Visibility="{Binding IsBatch, Converter={StaticResource Vis}}"
                                   Text="Each video is saved as its own name plus _av1.mp4 (.mkv when MP4 can't hold its streams). With no folder set, each one is saved next to its source." />
                        <TextBlock Style="{StaticResource StatLabel}" Margin="0,6,0,0" Text="{Binding ContainerNote}"
                                   Visibility="{Binding HasContainerNote, Converter={StaticResource Vis}}" />
                        <StackPanel Visibility="{Binding IsCompressMode, Converter={StaticResource Vis}}">
                            <CheckBox Content="Delete the original after the new file passes a check" IsChecked="{Binding DeleteOriginals}" Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource StatLabel}" Margin="28,2,0,0" TextWrapping="Wrap"
                                       Text="The new file must be at least 10% smaller, the same length, and play from start to end without an error. The original then goes to the Recycle Bin (network drives have none, so it is deleted there). If any check fails, the original is kept. Off each time the app starts." />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Action bar -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Click="OnCancel" MinWidth="96" Margin="0,0,8,0"
                            Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}" />
                    <Button Content="{Binding PauseLabel}" Click="OnPause" MinWidth="96" Margin="0,0,8,0"
                            Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}" />
                    <Button Content="{Binding StartLabel}" Click="OnStart" MinWidth="120" IsEnabled="{Binding CanStart}"
                            Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
